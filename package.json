{
  "name": "kitchencam",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand && node --test tests/client-boundary.test.cjs tests/backend-foundation.test.cjs",
    "test:watch": "jest --watch",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "export:check": "expo export --platform all --output-dir dist",
    "doctor": "expo-doctor",
    "deps:check": "expo install --check",
    "backend:start": "supabase start",
    "backend:status": "supabase status",
    "backend:stop": "supabase stop --no-backup",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning",
    "db:types": "node tooling/generate-database-types.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "~0.21.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  }
}
