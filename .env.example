# All EXPO_PUBLIC_* values are shipped in the application. Never put secrets here.
EXPO_PUBLIC_APP_ENV=development
# Allowed values: development, staging, production.
# Local public values are printed by `pnpm backend:status` after the stack starts.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The local Edge runtime receives its generated server key from Supabase CLI.
# Never copy it into this file, app config extra, or an EXPO_PUBLIC_* variable.
